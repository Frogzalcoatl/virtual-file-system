{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Configure",
            "type": "shell",
            "command": "cmake --preset default",
            "problemMatcher": []
        },
        {
            "label": "Build",
            "type": "shell",
            "command": "cmake --build build",
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "clear": true,
                "reveal": "always",
                "focus": false
            }
        },
        {
            "label": "Test",
            "type": "shell",
            "command": "cmake --build build && ctest --preset default",
            "problemMatcher": [],
            "presentation": {
                "clear": true,
                "reveal": "always",
                "focus": false
            }
        }
    ]
}